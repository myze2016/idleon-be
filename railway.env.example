# Set these in Railway Variables. This file contains no real credentials.
NODE_ENV=production
TRUST_PROXY_HOPS=1
DATABASE_URL=${{Postgres.DATABASE_URL}}
CORS_ORIGIN=https://YOUR-FRONTEND.vercel.app
SESSION_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
# Google and Resend are optional until you configure them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-FRONTEND.vercel.app/api/auth/google/callback
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Only needed for one-time admin provisioning or changing its password.
SEED_ADMIN_PASSWORD=
