generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  admin
  player
}

enum Weapon {
  sword_and_shield @map("sword-and-shield")
  bow
  wand
  staff
  book
  spear
  axe
  rifle
  dual_gun        @map("dual-gun")
  great_sword     @map("great-sword")
  dual_knife      @map("dual-knife")
  glaive
  ice_staff       @map("ice-staff")
  dual_axe        @map("dual-axe")
}

model User {
  id           String     @id @default(cuid()) @db.VarChar(30)
  username     String     @unique @db.VarChar(100)
  name         String     @db.VarChar(100)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(player)
  characters   Character[]
  starterCreated Boolean @default(false) @map("starter_created")
  wishCurrency Int @default(0) @map("wish_currency")
  gold         Int @default(0) @db.UnsignedInt
  experience   Int @default(0) @db.UnsignedInt
  meadowDefeats Int @default(0) @map("meadow_defeats") @db.UnsignedInt
  meadowBossAt Int? @map("meadow_boss_at") @db.UnsignedInt
  tourneyDefeats Int @default(0) @map("tourney_defeats") @db.UnsignedInt
  tourneyBossAt Int? @map("tourney_boss_at") @db.UnsignedInt
  tourneySpectator Json? @map("tourney_spectator")
  garnalandUnlocked Boolean @default(false) @map("garnaland_unlocked")
  deepSeaFloor Int @default(1) @map("deep_sea_floor") @db.UnsignedInt
  deepSeaProgress Json? @map("deep_sea_progress")
  harborDefeats Int @default(0) @map("harbor_defeats") @db.UnsignedInt
  harborBossAt Int? @map("harbor_boss_at") @db.UnsignedInt
  forestDefeats Int @default(0) @map("forest_defeats") @db.UnsignedInt
  forestBossAt Int? @map("forest_boss_at") @db.UnsignedInt
  expeditionVitals Json? @map("expedition_vitals")
  teamSlots Json? @map("team_slots")
  encounters   Encounter[]
  artifacts    Artifact[]
  questItems   QuestItem[]
  pvpHosted PvpRoom[] @relation("PvpHost")
  pvpJoined PvpRoom[] @relation("PvpGuest")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model PvpRoom {
  id String @id @default(cuid()) @db.VarChar(30)
  code String @unique @db.VarChar(12)
  hostId String @map("host_id") @db.VarChar(30)
  host User @relation("PvpHost", fields: [hostId], references: [id], onDelete: Cascade)
  guestId String? @map("guest_id") @db.VarChar(30)
  guest User? @relation("PvpGuest", fields: [guestId], references: [id], onDelete: SetNull)
  hostCharacterId String? @map("host_character_id") @db.VarChar(30)
  guestCharacterId String? @map("guest_character_id") @db.VarChar(30)
  hostCharacterIds Json? @map("host_character_ids")
  guestCharacterIds Json? @map("guest_character_ids")
  hostReady Boolean @default(false) @map("host_ready")
  guestReady Boolean @default(false) @map("guest_ready")
  status String @default("waiting") @db.VarChar(16)
  startsAt DateTime? @map("starts_at")
  result Json?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hostId, status])
  @@index([guestId, status])
  @@map("pvp_rooms")
}

model QuestItem {
  userId String @map("user_id") @db.VarChar(30)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId String @map("item_id") @db.VarChar(40)
  acquiredAt DateTime @default(now()) @map("acquired_at")

  @@id([userId, itemId])
  @@map("quest_items")
}

model Character {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @map("user_id") @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(24)
  weapon    Weapon
  isStarter Boolean @default(false) @map("is_starter")
  skill2Unlocked Boolean @default(false) @map("skill_2_unlocked")
  upgradeLevel Int @default(0) @map("upgrade_level") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  artifact Artifact?

  @@index([userId, createdAt])
  @@map("characters")
}

model Artifact {
  enhancementLevel Int @default(0) @map("enhancement_level") @db.UnsignedInt
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @map("user_id") @db.VarChar(30)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stat String @db.VarChar(16)
  characterId String? @unique @map("character_id") @db.VarChar(30)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("artifacts")
}

model Session {
  id        String   @id @db.VarChar(128)
  data      String   @db.LongText
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("sessions")
}

model Encounter {
  id        String @id @default(cuid()) @db.VarChar(30)
  userId    String @map("user_id") @db.VarChar(30)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enemyType String @map("enemy_type") @db.VarChar(24)
  location String @default("meadow") @db.VarChar(16)
  battleId String? @map("battle_id") @db.VarChar(30)
  teamIds   Json @map("team_ids")
  result    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("encounters")
}
