generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  player
}

enum Weapon {
  sword_and_shield @map("sword-and-shield")
  bow
  wand
  staff
  book
  spear
  axe
  rifle
  dual_gun        @map("dual-gun")
  great_sword     @map("great-sword")
  dual_knife      @map("dual-knife")
  glaive
  ice_staff       @map("ice-staff")
  dual_axe        @map("dual-axe")
}

model User {
  id           String     @id @default(cuid()) @db.VarChar(30)
  username     String     @unique @db.VarChar(100)
  email        String?    @unique @db.VarChar(254)
  googleSubject String?   @unique @map("google_subject") @db.VarChar(255)
  supportPhoneLast4 String? @map("support_phone_last4") @db.VarChar(4)
  supportIdentifiedAt DateTime? @map("support_identified_at")
  name         String     @db.VarChar(100)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(player)
  characters   Character[]
  starterCreated Boolean @default(false) @map("starter_created")
  wishCurrency Int @default(0) @map("wish_currency")
  donationTier Int @default(0) @map("donation_tier")
  donationChanges DonationTierChange[] @relation("DonationRecipient")
  donationChangesMade DonationTierChange[] @relation("DonationAdmin")
  supportSubmissions SupportSubmission[] @relation("SupportSender")
  supportReviews SupportSubmission[] @relation("SupportReviewer")
  wishGrants WishCurrencyGrant[] @relation("WishGrantRecipient")
  wishGrantsMade WishCurrencyGrant[] @relation("WishGrantAdmin")
  accountGrantEntries AccountGrantEntry[]
  gold         Int @default(0)
  experience   Int @default(0)
  meadowDefeats Int @default(0) @map("meadow_defeats")
  meadowBossAt Int? @map("meadow_boss_at")
  tourneyDefeats Int @default(0) @map("tourney_defeats")
  tourneyBossAt Int? @map("tourney_boss_at")
  tourneySpectator Json? @map("tourney_spectator")
  garnalandUnlocked Boolean @default(false) @map("garnaland_unlocked")
  deepSeaFloor Int @default(1) @map("deep_sea_floor")
  deepSeaProgress Json? @map("deep_sea_progress")
  harborDefeats Int @default(0) @map("harbor_defeats")
  harborBossAt Int? @map("harbor_boss_at")
  forestDefeats Int @default(0) @map("forest_defeats")
  forestBossAt Int? @map("forest_boss_at")
  expeditionVitals Json? @map("expedition_vitals")
  teamSlots Json? @map("team_slots")
  encounters   Encounter[]
  artifacts    Artifact[]
  questItems   QuestItem[]
  wishPayments WishPayment[]
  pvpHosted PvpRoom[] @relation("PvpHost")
  pvpJoined PvpRoom[] @relation("PvpGuest")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model RegistrationCode {
  email String @id @db.VarChar(254)
  codeHash String @map("code_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  sentAt DateTime @map("sent_at")
  attempts Int @default(0)

  @@map("registration_codes")
}

model PvpRoom {
  id String @id @default(cuid()) @db.VarChar(30)
  code String @unique @db.VarChar(12)
  hostId String @map("host_id") @db.VarChar(30)
  host User @relation("PvpHost", fields: [hostId], references: [id], onDelete: Cascade)
  guestId String? @map("guest_id") @db.VarChar(30)
  guest User? @relation("PvpGuest", fields: [guestId], references: [id], onDelete: SetNull)
  hostCharacterId String? @map("host_character_id") @db.VarChar(30)
  guestCharacterId String? @map("guest_character_id") @db.VarChar(30)
  hostCharacterIds Json? @map("host_character_ids")
  guestCharacterIds Json? @map("guest_character_ids")
  hostReady Boolean @default(false) @map("host_ready")
  guestReady Boolean @default(false) @map("guest_ready")
  status String @default("waiting") @db.VarChar(16)
  startsAt DateTime? @map("starts_at")
  result Json?
  messages Json?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hostId, status])
  @@index([guestId, status])
  @@map("pvp_rooms")
}

model QuestItem {
  userId String @map("user_id") @db.VarChar(30)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId String @map("item_id") @db.VarChar(40)
  acquiredAt DateTime @default(now()) @map("acquired_at")

  @@id([userId, itemId])
  @@map("quest_items")
}

model Character {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @map("user_id") @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(24)
  weapon    Weapon
  isStarter Boolean @default(false) @map("is_starter")
  skill2Unlocked Boolean @default(false) @map("skill_2_unlocked")
  upgradeLevel Int @default(0) @map("upgrade_level")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  artifact Artifact?

  @@index([userId, createdAt])
  @@map("characters")
}

model Artifact {
  enhancementLevel Int @default(0) @map("enhancement_level")
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @map("user_id") @db.VarChar(30)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stat String @db.VarChar(16)
  characterId String? @unique @map("character_id") @db.VarChar(30)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("artifacts")
}

model Session {
  id        String   @id @db.VarChar(128)
  data      String   @db.Text
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("sessions")
}

model WishPayment {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @map("user_id") @db.VarChar(30)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestKey String @unique @map("request_key") @db.VarChar(36)
  intentId String? @unique @map("intent_id") @db.VarChar(80)
  paymentId String? @unique @map("payment_id") @db.VarChar(80)
  eventId String? @unique @map("event_id") @db.VarChar(80)
  amount Int @default(1000)
  currency String @default("PHP") @db.VarChar(3)
  wishes Int @default(100)
  livemode Boolean
  status String @default("creating") @db.VarChar(16)
  qrImage String? @map("qr_image") @db.Text
  expiresAt DateTime @map("expires_at")
  creditedAt DateTime? @map("credited_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("wish_payments")
}

model DonationTierChange {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @map("user_id") @db.VarChar(30)
  user User @relation("DonationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  adminId String @map("admin_id") @db.VarChar(30)
  admin User @relation("DonationAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  fromTier Int @map("from_tier")
  toTier Int @map("to_tier")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("donation_tier_changes")
}

model Encounter {
  id        String @id @default(cuid()) @db.VarChar(30)
  userId    String @map("user_id") @db.VarChar(30)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enemyType String @map("enemy_type") @db.VarChar(24)
  location String @default("meadow") @db.VarChar(16)
  battleId String? @map("battle_id") @db.VarChar(30)
  teamIds   Json @map("team_ids")
  result    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("encounters")
}

model GameBalance {
  id Int @id @default(1)
  version Int @default(0)
  config Json
  updatedAt DateTime @updatedAt
  @@map("game_balance")
}

model BalanceRevision {
  id Int @id @default(autoincrement())
  patchVersion Int? @unique
  patchChanges Json?
  adminId String @db.VarChar(30)
  note String @db.VarChar(300)
  config Json
  createdAt DateTime @default(now())
  @@map("balance_revisions")
}

model SupportSettings {
  id Int @id @default(1)
  qrImage String? @map("qr_image") @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_settings")
}

model WishCurrencyGrant {
  batchId String? @map("batch_id") @db.VarChar(36)
  batch WishCurrencyBatch? @relation(fields: [batchId], references: [requestKey], onDelete: Restrict)
  id String @id @default(cuid()) @db.VarChar(30)
  requestKey String @unique @map("request_key") @db.VarChar(36)
  userId String @map("user_id") @db.VarChar(30)
  user User @relation("WishGrantRecipient", fields: [userId], references: [id], onDelete: Restrict)
  adminId String @map("admin_id") @db.VarChar(30)
  admin User @relation("WishGrantAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  amount Int
  balanceBefore Int @map("balance_before")
  balanceAfter Int @map("balance_after")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("wish_currency_grants")
}

model WishCurrencyBatch {
  requestKey String @id @map("request_key") @db.VarChar(36)
  adminId String @map("admin_id") @db.VarChar(30)
  donationTier Int @map("donation_tier")
  amount Int
  recipientsHash String @map("recipients_hash") @db.VarChar(64)
  recipientIds Json @map("recipient_ids")
  recipientCount Int @map("recipient_count")
  createdAt DateTime @default(now()) @map("created_at")
  grants WishCurrencyGrant[]
  @@map("wish_currency_batches")
}

model AccountGrant {
  requestKey String @id @map("request_key") @db.VarChar(36)
  adminId String @map("admin_id") @db.VarChar(30)
  kind String @db.VarChar(10)
  amount Int
  targetUserId String? @map("target_user_id") @db.VarChar(30)
  donationTier Int? @map("donation_tier")
  recipientsHash String? @map("recipients_hash") @db.VarChar(64)
  result Json
  createdAt DateTime @default(now()) @map("created_at")
  entries AccountGrantEntry[]
  @@map("account_grants")
}

model AccountGrantEntry {
  id String @id @default(cuid()) @db.VarChar(30)
  requestKey String @map("request_key") @db.VarChar(36)
  grant AccountGrant @relation(fields: [requestKey], references: [requestKey], onDelete: Restrict)
  userId String @map("user_id") @db.VarChar(30)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  goldBefore Int @map("gold_before")
  goldAfter Int @map("gold_after")
  experienceBefore Int @map("experience_before")
  experienceAfter Int @map("experience_after")
  wishBefore Int @map("wish_before")
  wishAfter Int @map("wish_after")
  levelBefore Int @map("level_before")
  levelAfter Int @map("level_after")
  @@unique([requestKey, userId])
  @@index([userId])
  @@map("account_grant_entries")
}

model SupportSubmission {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @map("user_id") @db.VarChar(30)
  user User @relation("SupportSender", fields: [userId], references: [id], onDelete: Restrict)
  tier Int
  amount Decimal @db.Decimal(12, 2)
  phone String @db.VarChar(16)
  reference String @unique @db.VarChar(64)
  status String @default("pending") @db.VarChar(16)
  reviewedById String? @map("reviewed_by_id") @db.VarChar(30)
  reviewedBy User? @relation("SupportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt DateTime? @map("reviewed_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("support_submissions")
}
